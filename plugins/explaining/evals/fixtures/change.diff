-import { describe, expect, test } from "bun:test";
+import { describe, expect, mock, test } from "bun:test";
 import { BillingClient } from "./client";

 function response(status: number, body = "{}", headers: Record<string, string> = {}): Response {
@@ -14,3 +14,41 @@ describe("BillingClient.charge", () => {
     expect(await client.charge({ customerId: "c1", amountCents: 100, currency: "USD" })).toEqual({ chargeId: "ch_1", status: "succeeded" });
   });
+
+  test("sends the same Idempotency-Key on every retry of one charge", async () => {
+    const keys: string[] = [];
+    const fetchImpl = mock(async (_url: string, init: RequestInit) => {
+      keys.push((init.headers as Record<string, string>)["Idempotency-Key"]);
+      return keys.length < 3 ? response(503) : response(200, JSON.stringify({ chargeId: "ch_1", status: "succeeded" }));
+    });
+    const client = new BillingClient("http://x", fetchImpl as unknown as typeof fetch, async () => {}, () => 0);
+    await client.charge({ customerId: "c1", amountCents: 100, currency: "USD" });
+    expect(new Set(keys).size).toBe(1);
+  });
+
+  test("honours Retry-After over the computed delay", async () => {
+    const delays: number[] = [];
+    let calls = 0;
+    const fetchImpl = mock(async () => (calls++ === 0 ? response(429, "{}", { "Retry-After": "2" }) : response(200, JSON.stringify({ chargeId: "ch_1", status: "succeeded" }))));
+    const client = new BillingClient("http://x", fetchImpl as unknown as typeof fetch, async (ms) => { delays.push(ms); }, () => 0.5);
+    await client.charge({ customerId: "c1", amountCents: 100, currency: "USD" });
+    expect(delays).toEqual([2000]);
+  });
+
+  test("opens the breaker after five failures and rejects without calling upstream", async () => {
+    let calls = 0;
+    const fetchImpl = mock(async () => { calls++; return response(503); });
+    const client = new BillingClient("http://x", fetchImpl as unknown as typeof fetch, async () => {}, () => 0);
+    await expect(client.charge({ customerId: "c1", amountCents: 100, currency: "USD" })).rejects.toThrow("circuit open");
+    expect(calls).toBe(5);
+  });
 });
